{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "report-v2.schema.json",
  "title": "FocusDeck v2 report \u2014 timed/untimed evidence",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "complete",
        "stopped"
      ]
    },
    "planned_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "active_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "focused_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "break_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "paused_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "wall_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "started_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "finished_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000000
    },
    "blocks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "enum": [
              "focus",
              "break"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "planned_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "budget_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "active_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "paused_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "started_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "finished_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "outcome": {
            "enum": [
              "done",
              "stopped",
              "skipped"
            ]
          },
          "overtime_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          },
          "performance": {
            "anyOf": [
              {
                "$ref": "#/$defs/performance"
              },
              {
                "type": "null"
              }
            ]
          },
          "timer_mode": {
            "enum": [
              "countdown",
              "stopwatch"
            ]
          },
          "wall_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "focus_ratio": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "planned_ms",
          "budget_ms",
          "active_ms",
          "paused_ms",
          "started_at_ms",
          "finished_at_ms",
          "outcome",
          "timer_mode",
          "wall_ms",
          "focus_ratio",
          "overtime_ms"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "timer_mode": {
                  "const": "stopwatch"
                }
              },
              "required": [
                "timer_mode"
              ]
            },
            "then": {
              "properties": {
                "type": {
                  "const": "focus"
                },
                "planned_ms": {
                  "type": "null"
                },
                "budget_ms": {
                  "type": "null"
                },
                "overtime_ms": {
                  "type": "null"
                },
                "performance": {
                  "properties": {
                    "pace_index": {
                      "type": "null"
                    },
                    "beat_score": {
                      "type": "null"
                    },
                    "rank": {
                      "type": "null"
                    },
                    "performance_class": {
                      "type": "null"
                    },
                    "classification": {
                      "type": "null"
                    },
                    "comparison": {
                      "type": "null"
                    },
                    "reward_contract": {
                      "type": "null"
                    },
                    "previous_benchmark": {
                      "type": "null"
                    },
                    "pb_delta": {
                      "type": "null"
                    },
                    "quality": {
                      "const": "confirmed"
                    },
                    "recalibration_needed": {
                      "const": false
                    },
                    "new_personal_best": {
                      "const": false
                    },
                    "reward_policy": {
                      "properties": {
                        "tiers": {
                          "items": {
                            "properties": {
                              "min_beat_score": {
                                "type": "null"
                              },
                              "max_beat_score": {
                                "type": "null"
                              },
                              "min_pace_index": {
                                "type": "null"
                              },
                              "min_session_score": {
                                "type": "null"
                              },
                              "max_session_score": {
                                "type": "null"
                              },
                              "condition": {
                                "enum": [
                                  "completed",
                                  "module_completed"
                                ]
                              }
                            },
                            "required": [
                              "condition"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "planned_ms": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 86400000,
                  "multipleOf": 1000
                },
                "budget_ms": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 86400000,
                  "multipleOf": 1000
                },
                "overtime_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000000000
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "focus"
                },
                "outcome": {
                  "const": "done"
                }
              },
              "required": [
                "type",
                "outcome"
              ]
            },
            "then": {
              "required": [
                "performance"
              ],
              "properties": {
                "performance": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/performance"
                    },
                    {
                      "properties": {
                        "quality": {
                          "const": "confirmed"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "outcome": {
                  "const": "skipped"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "properties": {
                "performance": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "timeline_coverage": {
      "enum": [
        "complete",
        "partial",
        "unavailable"
      ]
    },
    "planned_block_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "recorded_timezone": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 100
    },
    "events": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "kind",
          "at_ms",
          "mono_ms",
          "boot",
          "block_index",
          "phase",
          "active_ms",
          "paused_ms",
          "budget_ms"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "kind": {
            "enum": [
              "block_started",
              "paused",
              "resumed",
              "extended",
              "block_done",
              "block_stopped",
              "waiting_for_start",
              "session_complete",
              "session_stopped",
              "overtime_observed",
              "recovered_after_reboot",
              "review_started",
              "quality_confirmed",
              "quality_incomplete",
              "reward_offered",
              "reward_acknowledged",
              "reward_skipped",
              "session_reward_offered",
              "session_reward_acknowledged",
              "session_reward_skipped",
              "review_recovered_after_reboot",
              "reward_continued",
              "session_reward_continued",
              "block_skipped"
            ]
          },
          "at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 253402300799999
          },
          "mono_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000000
          },
          "boot": {
            "type": "integer",
            "minimum": -1,
            "maximum": 2147483647
          },
          "block_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "phase": {
            "enum": [
              "active",
              "paused",
              "between",
              "complete",
              "stopped",
              "quality",
              "reward",
              "session_reward"
            ]
          },
          "active_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "paused_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000000
          },
          "budget_ms": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 1000000000000
          }
        }
      }
    },
    "overtime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "competition": {
      "$ref": "#/$defs/competition"
    },
    "report_version": {
      "const": 2,
      "type": "integer"
    },
    "timed_planned_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800000
    },
    "planned_countdown_focus_blocks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "planned_stopwatch_focus_blocks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "schedule_snapshot": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "session_schedule",
        "activities"
      ],
      "properties": {
        "session_schedule": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "planned_start"
          ],
          "properties": {
            "planned_start": {
              "type": "string",
              "format": "date-time",
              "maxLength": 60
            },
            "planned_end": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time",
              "maxLength": 60
            },
            "timezone": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 100
            }
          }
        },
        "activities": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "type"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "type": {
                "enum": [
                  "focus",
                  "break"
                ]
              },
              "schedule": {
                "type": [
                  "object",
                  "null"
                ],
                "additionalProperties": false,
                "required": [
                  "planned_start"
                ],
                "properties": {
                  "planned_start": {
                    "type": "string",
                    "format": "date-time",
                    "maxLength": 60
                  },
                  "planned_end": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "date-time",
                    "maxLength": 60
                  },
                  "timezone": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 100
                  }
                }
              },
              "category": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 200
              },
              "achievement_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 200
              },
              "index_topic_id": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 200
              },
              "planned_ms": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1000000000000
              },
              "timer_mode": {
                "enum": [
                  "countdown",
                  "stopwatch",
                  null
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "session_id",
    "title",
    "status",
    "planned_ms",
    "active_ms",
    "focused_ms",
    "break_ms",
    "paused_ms",
    "wall_ms",
    "started_at_ms",
    "finished_at_ms",
    "blocks",
    "report_version",
    "timed_planned_ms",
    "planned_countdown_focus_blocks",
    "planned_stopwatch_focus_blocks",
    "competition",
    "planned_block_count"
  ],
  "$defs": {
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "complexity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "target_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "work_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "category",
        "complexity",
        "method",
        "target_revision",
        "work_units"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "pushups",
            "squats",
            "plank",
            "mobility",
            "walk",
            "stretching",
            "guitar",
            "coffee",
            "text"
          ]
        },
        "reps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 900
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "reps": {
                "const": 0
              },
              "seconds": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "text": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "maxItems": 3,
          "minItems": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/action"
            },
            "maxItems": 3,
            "minItems": 1
          },
          "maxItems": 4,
          "minItems": 0
        }
      },
      "required": [
        "actions"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completion": {
          "anyOf": [
            {
              "$ref": "#/$defs/option"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/option"
            },
            {
              "type": "null"
            }
          ]
        },
        "strong": {
          "anyOf": [
            {
              "$ref": "#/$defs/option"
            },
            {
              "type": "null"
            }
          ]
        },
        "personal_best": {
          "anyOf": [
            {
              "$ref": "#/$defs/option"
            },
            {
              "type": "null"
            }
          ]
        },
        "exceptional": {
          "anyOf": [
            {
              "$ref": "#/$defs/option"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rank_thresholds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 111
          },
          "maxItems": 4,
          "minItems": 4
        },
        "target_pace": {
          "type": "number",
          "minimum": 80,
          "maximum": 100
        },
        "strong_pace": {
          "type": "number",
          "minimum": 100,
          "maximum": 120
        },
        "target_focus": {
          "type": "number",
          "minimum": 50,
          "maximum": 100
        },
        "strong_focus": {
          "type": "number",
          "minimum": 50,
          "maximum": 100
        },
        "recalibration_pace": {
          "type": "number",
          "minimum": 125,
          "maximum": 200
        }
      }
    },
    "coffee": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minimum_productive_session_seconds": {
          "type": "integer",
          "minimum": 10800,
          "maximum": 86400
        },
        "minimum_hours_between_coffee_rewards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "latest_allowed_local_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "const": "physical_competitive"
        },
        "allowed_rewards": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "enum": [
              "pushups",
              "squats",
              "plank",
              "mobility",
              "walk",
              "stretching",
              "guitar",
              "coffee"
            ]
          },
          "maxItems": 8,
          "minItems": 1
        },
        "forbidden_rewards": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 20,
          "minItems": 0
        },
        "default_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/contract"
            },
            {
              "type": "null"
            }
          ]
        },
        "scoring": {
          "$ref": "#/$defs/scoring"
        },
        "daily_rep_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pushups": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "squats": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "pushups",
            "squats"
          ]
        },
        "daily_physical_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1200
        },
        "max_consecutive_same_activity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "coffee_reward": {
          "$ref": "#/$defs/coffee"
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 111
        },
        "active_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      },
      "required": [
        "report_key",
        "score",
        "active_ms"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "string",
          "pattern": "^(none|completion|target|strong|personal_best|exceptional|tier_[1-9][0-9]?)$"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "maxItems": 3,
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "acknowledged": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "acknowledged_at_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 253402300799999
            },
            {
              "type": "null"
            }
          ]
        },
        "local_day": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "daily_reps_before": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pushups": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "squats": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
