{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-v1.schema.json",
  "title": "FocusDeck v1 session",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "session_id",
    "title",
    "created_at",
    "blocks"
  ],
  "properties": {
    "protocol_version": {
      "const": 1,
      "type": "integer"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 60
    },
    "auto_advance": {
      "type": "boolean",
      "default": true
    },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "title",
          "duration_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "type": {
            "enum": [
              "focus",
              "break"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "quality_criteria": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "maxItems": 10,
            "minItems": 0
          },
          "comparison": {
            "anyOf": [
              {
                "$ref": "#/$defs/comparison"
              },
              {
                "type": "null"
              }
            ]
          },
          "reward_contract": {
            "anyOf": [
              {
                "$ref": "#/$defs/contract"
              },
              {
                "type": "null"
              }
            ]
          },
          "reward_policy": {
            "anyOf": [
              {
                "$ref": "#/$defs/conditional_policy"
              },
              {
                "type": "null"
              }
            ]
          },
          "session_weight": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 10
          },
          "classification": {
            "anyOf": [
              {
                "$ref": "#/$defs/classification"
              },
              {
                "type": "null"
              }
            ]
          },
          "schedule": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "planned_start"
            ],
            "properties": {
              "planned_start": {
                "type": "string",
                "format": "date-time",
                "maxLength": 60
              },
              "planned_end": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "maxLength": 60
              },
              "timezone": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              }
            }
          },
          "category": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          },
          "achievement_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          },
          "index_topic_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "reward_strategy": {
      "anyOf": [
        {
          "$ref": "#/$defs/strategy"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_reward": {
      "anyOf": [
        {
          "$ref": "#/$defs/contract"
        },
        {
          "type": "null"
        }
      ]
    },
    "comparison_key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "session_reward_policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/conditional_policy"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "session_scoring": {
      "$ref": "#/$defs/session_scoring"
    },
    "schedule": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "planned_start"
      ],
      "properties": {
        "planned_start": {
          "type": "string",
          "format": "date-time",
          "maxLength": 60
        },
        "planned_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time",
          "maxLength": 60
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        }
      }
    }
  },
  "$comment": "Runtime additionally rejects whitespace-only strings, duplicate block IDs and a total duration above 604800 seconds. created_at requires a timezone. Session durations are relative; created_at does not schedule an automatic start. Reward runtime validation additionally checks permitted tiers/action ranges, physical reset length, allowed kinds, score threshold ordering, break restrictions, contract permission and a 128 KiB encoded reward plan limit. V1.6 runtime checks classify DONE blocks, recompute weighted results and validate conditional thresholds; legacy report fields remain readable.",
  "$defs": {
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "complexity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "target_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "work_units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "required": [
        "category",
        "complexity",
        "method",
        "target_revision",
        "work_units"
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "pushups",
            "squats",
            "plank",
            "mobility",
            "walk",
            "stretching",
            "guitar",
            "coffee",
            "text"
          ]
        },
        "reps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 900
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              "reps": {
                "const": 0
              },
              "seconds": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "text": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "maxItems": 3,
          "minItems": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/action"
            },
            "maxItems": 3,
            "minItems": 1
          },
          "maxItems": 4,
          "minItems": 0
        }
      },
      "required": [
        "actions"
      ]
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "completion": {
          "anyOf": [
            {
              "$ref": "#/$defs/option"
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/option"
            },
            {
              "type": "null"
            }
          ]
        },
        "strong": {
          "anyOf": [
            {
              "$ref": "#/$defs/option"
            },
            {
              "type": "null"
            }
          ]
        },
        "personal_best": {
          "anyOf": [
            {
              "$ref": "#/$defs/option"
            },
            {
              "type": "null"
            }
          ]
        },
        "exceptional": {
          "anyOf": [
            {
              "$ref": "#/$defs/option"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rank_thresholds": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 1,
            "maximum": 111
          },
          "maxItems": 4,
          "minItems": 4
        },
        "target_pace": {
          "type": "number",
          "minimum": 80,
          "maximum": 100
        },
        "strong_pace": {
          "type": "number",
          "minimum": 100,
          "maximum": 120
        },
        "target_focus": {
          "type": "number",
          "minimum": 50,
          "maximum": 100
        },
        "strong_focus": {
          "type": "number",
          "minimum": 50,
          "maximum": 100
        },
        "recalibration_pace": {
          "type": "number",
          "minimum": 125,
          "maximum": 200
        }
      }
    },
    "coffee": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minimum_productive_session_seconds": {
          "type": "integer",
          "minimum": 10800,
          "maximum": 86400
        },
        "minimum_hours_between_coffee_rewards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "latest_allowed_local_time": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "const": "physical_competitive"
        },
        "allowed_rewards": {
          "uniqueItems": true,
          "type": "array",
          "items": {
            "enum": [
              "pushups",
              "squats",
              "plank",
              "mobility",
              "walk",
              "stretching",
              "guitar",
              "coffee"
            ]
          },
          "maxItems": 8,
          "minItems": 1
        },
        "forbidden_rewards": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "maxItems": 20,
          "minItems": 0
        },
        "default_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/contract"
            },
            {
              "type": "null"
            }
          ]
        },
        "scoring": {
          "$ref": "#/$defs/scoring"
        },
        "daily_rep_limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pushups": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "squats": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "pushups",
            "squats"
          ]
        },
        "daily_physical_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1200
        },
        "max_consecutive_same_activity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "coffee_reward": {
          "$ref": "#/$defs/coffee"
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "block_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 111
        },
        "active_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000000
        }
      },
      "required": [
        "report_key",
        "score",
        "active_ms"
      ]
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "type": "string",
          "pattern": "^(none|completion|target|strong|personal_best|exceptional|tier_[1-9][0-9]?)$"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "maxItems": 3,
          "minItems": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "acknowledged": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "acknowledged_at_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 253402300799999
            },
            {
              "type": "null"
            }
          ]
        },
        "local_day": {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "daily_reps_before": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pushups": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            },
            "squats": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000000
            }
          }
        },
        "daily_physical_seconds_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "required": [
        "tier",
        "actions",
        "acknowledged",
        "skipped"
      ]
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quality": {
          "enum": [
            "pending",
            "confirmed",
            "incomplete"
          ]
        },
        "quality_criteria": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "maxItems": 10,
          "minItems": 0
        },
        "comparison": {
          "anyOf": [
            {
              "$ref": "#/$defs/comparison"
            },
            {
              "type": "null"
            }
          ]
        },
        "wall_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000000
        },
        "pace_index": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "focus_ratio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "beat_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 111
        },
        "rank": {
          "enum": [
            "C",
            "B",
            "A",
            "S",
            "S+"
          ]
        },
        "recalibration_needed": {
          "type": "boolean"
        },
        "previous_benchmark": {
          "anyOf": [
            {
              "$ref": "#/$defs/benchmark"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_personal_best": {
          "type": "boolean"
        },
        "pb_delta": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -111,
              "maximum": 111
            },
            {
              "type": "null"
            }
          ]
        },
        "scoring": {
          "$ref": "#/$defs/scoring"
        },
        "reward": {
          "$ref": "#/$defs/receipt"
        },
        "reward_contract": {
          "anyOf": [
            {
              "$ref": "#/$defs/contract"
            },
            {
              "type": "null"
            }
          ]
        },
        "reward_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/conditional_policy"
            },
            {
              "type": "null"
            }
          ]
        },
        "performance_class": {
          "enum": [
            "strong",
            "on_target",
            "slightly_over",
            "over_target",
            null
          ]
        },
        "session_weight": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 10
        },
        "classification": {
          "anyOf": [
            {
              "$ref": "#/$defs/classification"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "quality",
        "wall_ms",
        "beat_score",
        "rank",
        "recalibration_needed",
        "new_personal_best",
        "scoring",
        "reward"
      ]
    },
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "comparison_key": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "planned_focus_blocks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "completed_focus_blocks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "on_or_ahead_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "completion_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "average_pace": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000000
            },
            {
              "type": "null"
            }
          ]
        },
        "focus_ratio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            {
              "type": "null"
            }
          ]
        },
        "beat_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 111
        },
        "rank": {
          "enum": [
            "C",
            "B",
            "A",
            "S",
            "S+"
          ]
        },
        "previous_benchmark": {
          "anyOf": [
            {
              "$ref": "#/$defs/benchmark"
            },
            {
              "type": "null"
            }
          ]
        },
        "new_personal_best": {
          "type": "boolean"
        },
        "pb_delta": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -111,
              "maximum": 111
            },
            {
              "type": "null"
            }
          ]
        },
        "reward_strategy": {
          "$ref": "#/$defs/strategy"
        },
        "session_reward": {
          "anyOf": [
            {
              "$ref": "#/$defs/contract"
            },
            {
              "type": "null"
            }
          ]
        },
        "reward": {
          "$ref": "#/$defs/receipt"
        },
        "weighted": {
          "anyOf": [
            {
              "$ref": "#/$defs/weighted"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_reward_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/conditional_policy"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "planned_focus_blocks",
        "completed_focus_blocks",
        "on_or_ahead_count",
        "completion_fraction",
        "beat_score",
        "rank",
        "new_personal_best",
        "reward_strategy",
        "reward"
      ]
    },
    "typed_reward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "pushups",
            "squats",
            "plank",
            "mobility",
            "walk",
            "stretching",
            "guitar",
            "coffee",
            "combined",
            "text"
          ]
        },
        "amount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 900
            },
            {
              "type": "null"
            }
          ]
        },
        "duration_minutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 15
            },
            {
              "type": "null"
            }
          ]
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/typed_reward"
          },
          "maxItems": 3,
          "minItems": 0
        },
        "text": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "type"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "text"
                  }
                }
              },
              {
                "required": [
                  "text"
                ],
                "properties": {
                  "text": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
